<section class="participant-info" aria-labelledby="participant-info-title">
  <div class="profile-heading">
    <div class="profile-avatar" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="8" r="4" />
        <path d="M5 21a7 7 0 0 1 14 0" />
      </svg>
    </div>

    <div class="profile-heading-text">
      <h3 id="participant-info-title">Información del participante</h3>
      <p>Datos asociados a tu cuenta.</p>
    </div>
  </div>

  <dl class="profile-details">
    <div class="profile-field">
      <dt>Nombre completo</dt>
      <dd id="participant-name">—</dd>
    </div>

    <div class="profile-field">
      <dt>Correo electrónico</dt>
      <dd id="participant-email">—</dd>
    </div>
  </dl>

  <div class="profile-footer">
    <p
      id="session-status"
      class="session-status"
      role="status"
      aria-live="polite"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 6 9 17l-5-5" />
      </svg>

      <span id="session-status-text">Sesión activa.</span>
    </p>

    <button id="logout-button" type="button" class="logout-button">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </svg>

      <span id="logout-button-text">Cerrar sesión</span>
    </button>
  </div>
</section>

<style>
  .participant-info {
    width: 100%;
  }

  .profile-heading {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .profile-avatar {
    display: grid;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid #fed7aa;
    border-radius: 18px;
    background: #fff0e5;
    color: #ea5b0c;
  }

  .profile-heading-text {
    min-width: 0;
  }

  .profile-heading h3 {
    margin: 0 0 6px;
    color: #0f172a;
    font-size: 19px;
    line-height: 1.35;
  }

  .profile-heading p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.5;
  }

  .profile-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 28px 0;
  }

  .profile-field {
    min-width: 0;
    padding: 20px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #f8fafc;
  }

  .profile-field dt {
    margin-bottom: 9px;
    color: #64748b;
    font-size: 13px;
    font-weight: 500;
  }

  .profile-field dd {
    margin: 0;
    color: #0f172a;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .profile-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid #e2e8f0;
  }

  .session-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #15803d;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
  }

  .session-status.is-error {
    color: #b91c1c;
  }

  .session-status.is-error svg {
    display: none;
  }

  .logout-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 18px;
    border: 1px solid #fecaca;
    border-radius: 10px;
    background: #fff7f7;
    color: #b91c1c;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .logout-button:hover:not(:disabled) {
    border-color: #fca5a5;
    background: #fee2e2;
    transform: translateY(-1px);
  }

  .logout-button:focus-visible {
    outline: 3px solid #fdba74;
    outline-offset: 3px;
  }

  .logout-button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  @media (max-width: 600px) {
    .profile-heading {
      gap: 14px;
    }

    .profile-avatar {
      width: 56px;
      height: 56px;
      border-radius: 15px;
    }

    .profile-heading h3 {
      font-size: 17px;
    }

    .profile-details {
      grid-template-columns: 1fr;
      gap: 12px;
      margin: 24px 0;
    }

    .profile-field {
      padding: 18px;
    }

    .profile-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .logout-button {
      width: 100%;
    }
  }
</style>
