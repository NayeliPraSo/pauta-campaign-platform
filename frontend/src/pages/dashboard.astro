---
import ParticipantLayout from "../layouts/ParticipantLayout.astro";
import ParticipantProfile from "../components/participant/ParticipantProfile.astro";
import { campaignConfig } from "../config/campaign";
import { getParticipantNavigation } from "../config/participantNavigation";

const availableRoutes = new Set(["/tickets"]);

const availableModules = getParticipantNavigation(
  campaignConfig.participant,
).filter((item) => item.module !== undefined && availableRoutes.has(item.href));
---

<ParticipantLayout
  title="Mi panel"
  description="Consulta tu participación y accede a los módulos de la campaña."
>
  <div class="dashboard">
    <p
      id="session-loading"
      class="session-loading"
      role="status"
      aria-live="polite"
    >
      Verificando tu sesión...
    </p>

    <div id="dashboard-content" class="dashboard-content" hidden>
      <section class="welcome-section" aria-labelledby="dashboard-title">
        <span class="eyebrow">PAUTA CAMPAIGN PLATFORM</span>

        <h1 id="dashboard-title">
          ¡Hola, <span id="welcome-name">participante</span>!
        </h1>

        <p class="welcome-description">
          Bienvenido a tu espacio de participación. Desde aquí puedes consultar
          tu información y acceder a las actividades disponibles.
        </p>
      </section>

      <section class="stats-section" aria-labelledby="stats-title">
        <div class="section-heading">
          <h2 id="stats-title">Resumen de mis tickets</h2>
          <p>Consulta rápidamente el estado de tus participaciones.</p>
        </div>

        <div class="stats-card">
          <p id="stats-loading" class="stats-message" role="status">
            Cargando estadísticas...
          </p>

          <div id="stats-error" class="stats-error" role="alert" hidden>
            <p>No pudimos cargar las estadísticas de tus tickets.</p>
            <button id="retry-stats" type="button" class="retry-stats-button">
              Reintentar
            </button>
          </div>

          <div id="stats-grid" class="stats-grid" hidden>
            <article class="stat-item">
              <span class="stat-label">Tickets registrados</span>
              <strong id="stat-total" class="stat-value stat-total">
                0
              </strong>
            </article>

            <article class="stat-item">
              <span class="stat-label">Pendientes</span>
              <strong id="stat-pending" class="stat-value stat-pending">
                0
              </strong>
            </article>
          </div>

          <div class="stats-footer">
            <a href="/tickets" class="stats-link">
              Ver detalles de mis tickets
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>

      <section class="modules-section" aria-labelledby="modules-title">
        <div class="section-heading">
          <h2 id="modules-title">Mis actividades</h2>
          <p>Explora los módulos disponibles en esta campaña.</p>
        </div>

        {availableModules.length > 0 ? (
          <div class="modules-grid">
            {availableModules.map((module) => (
              <article class="module-card">
                <div class="module-icon" aria-hidden="true">
                  {module.id === "tickets" ? "🎟️" : "★"}
                </div>

                <div class="module-content">
                  <h3>
                    {module.id === "tickets"
                      ? "Mis comprobantes"
                      : module.label}
                  </h3>

                  <p>
                    {module.id === "tickets"
                      ? "Registra tus tickets de compra y consulta el estado de tus comprobantes."
                      : "Accede a esta actividad de la campaña."}
                  </p>
                </div>

                <a class="module-link" href={module.href}>
                  {module.id === "tickets"
                    ? "Ver mis tickets"
                    : "Ir a la actividad"}
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-modules">
            Por el momento no hay actividades disponibles.
          </p>
        )}
      </section>

      <section class="profile-section" aria-labelledby="profile-title">
        <div class="section-heading">
          <h2 id="profile-title">Mi información</h2>
          <p>Consulta los datos asociados a tu cuenta.</p>
        </div>

        <div class="profile-card">
          <ParticipantProfile />
        </div>
      </section>
    </div>

    <section
      id="session-error"
      class="error-card"
      aria-labelledby="error-title"
      hidden
    >
      <h1 id="error-title">No pudimos verificar tu sesión</h1>

      <p>
        Ocurrió un problema al comunicarnos con el servidor. Inténtalo
        nuevamente.
      </p>

      <button id="retry-button" type="button" class="retry-button">
        Reintentar
      </button>
    </section>
  </div>
</ParticipantLayout>

<script>
  import { ApiError } from "../lib/api";
  import { obtenerSesion, cerrarSesion } from "../lib/auth";
  import { obtenerHistorialTickets } from "../lib/tickets";
  import { calcularEstadisticasTickets } from "../lib/ticketStats";

  const sessionLoading =
    document.querySelector<HTMLElement>("#session-loading");

  const dashboardContent =
    document.querySelector<HTMLElement>("#dashboard-content");

  const sessionError = document.querySelector<HTMLElement>("#session-error");

  const sessionStatus = document.querySelector<HTMLElement>("#session-status");

  const sessionStatusText = document.querySelector<HTMLElement>(
    "#session-status-text",
  );

  const logoutButtonText = document.querySelector<HTMLElement>(
    "#logout-button-text",
  );

  const participantName =
    document.querySelector<HTMLElement>("#participant-name");

  const participantEmail =
    document.querySelector<HTMLElement>("#participant-email");

  const welcomeName = document.querySelector<HTMLElement>("#welcome-name");

  const logoutButton =
    document.querySelector<HTMLButtonElement>("#logout-button");

  const retryButton =
    document.querySelector<HTMLButtonElement>("#retry-button");

  const statsLoading = document.querySelector<HTMLElement>("#stats-loading");
  const statsError = document.querySelector<HTMLElement>("#stats-error");
  const statsGrid = document.querySelector<HTMLElement>("#stats-grid");
  const retryStatsButton =
    document.querySelector<HTMLButtonElement>("#retry-stats");

  function mostrarCargando(): void {
    if (sessionLoading) sessionLoading.hidden = false;
    if (dashboardContent) dashboardContent.hidden = true;
    if (sessionError) sessionError.hidden = true;
  }

  function mostrarDashboard(): void {
    if (sessionLoading) sessionLoading.hidden = true;
    if (dashboardContent) dashboardContent.hidden = false;
    if (sessionError) sessionError.hidden = true;
  }

  function mostrarError(): void {
    if (sessionLoading) sessionLoading.hidden = true;
    if (dashboardContent) dashboardContent.hidden = true;
    if (sessionError) sessionError.hidden = false;
  }

  async function cargarEstadisticas(): Promise<void> {
    if (statsLoading) statsLoading.hidden = false;
    if (statsError) statsError.hidden = true;
    if (statsGrid) statsGrid.hidden = true;
    if (retryStatsButton) retryStatsButton.disabled = true;

    try {
      const response = await obtenerHistorialTickets();
      const stats = calcularEstadisticasTickets(response.data);

      const valores: Record<string, number> = {
        "stat-total": stats.total,
        "stat-pending": stats.pending,
      };

      for (const [id, value] of Object.entries(valores)) {
        const element = document.getElementById(id);

        if (element) {
          element.textContent = String(value);
        }
      }

      if (statsGrid) statsGrid.hidden = false;
    } catch {
      if (statsError) statsError.hidden = false;
    } finally {
      if (statsLoading) statsLoading.hidden = true;
      if (retryStatsButton) retryStatsButton.disabled = false;
    }
  }

  async function verificarSesion(): Promise<void> {
    mostrarCargando();

    try {
      const response = await obtenerSesion();
      const participant = response.data.participant;

      if (participantName) {
        participantName.textContent = participant.full_name;
      }

      if (participantEmail) {
        participantEmail.textContent = participant.email;
      }

      if (welcomeName) {
        welcomeName.textContent =
          participant.full_name.trim().split(/\s+/)[0] || "participante";
      }

      if (sessionStatusText) {
        sessionStatusText.textContent = "Sesión activa.";
      }

      sessionStatus?.classList.remove("is-error");

      mostrarDashboard();
      void cargarEstadisticas();
    } catch (error) {
      if (error instanceof ApiError && error.status === 401) {
        window.location.replace("/login");
        return;
      }

      mostrarError();
    }
  }

  logoutButton?.addEventListener("click", async () => {
    if (!logoutButton || logoutButton.disabled) return;

    logoutButton.disabled = true;
    if (logoutButtonText) {
      logoutButtonText.textContent = "Cerrando sesión...";
    }

    try {
      await cerrarSesion();

      mostrarCargando();

      if (sessionLoading) {
        sessionLoading.textContent = "Sesión cerrada. Redirigiendo...";
      }

      window.location.replace("/login");
    } catch {
      if (sessionStatusText) {
        sessionStatusText.textContent =
          "No fue posible cerrar la sesión. Inténtalo nuevamente.";
      }

      sessionStatus?.classList.add("is-error");

      logoutButton.disabled = false;
      if (logoutButtonText) {
        logoutButtonText.textContent = "Cerrar sesión";
      }
    }
  });

  retryButton?.addEventListener("click", () => {
    void verificarSesion();
  });

  retryStatsButton?.addEventListener("click", () => {
    void cargarEstadisticas();
  });

  void verificarSesion();
</script>

<style>
  .dashboard {
    width: min(100% - 40px, 1100px);
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  .dashboard-content {
    display: grid;
    gap: 40px;
  }

  .dashboard-content[hidden],
  .session-loading[hidden],
  .error-card[hidden] {
    display: none;
  }

  .session-loading {
    padding: 80px 0;
    color: #64748b;
    text-align: center;
  }

  .welcome-section {
    padding: 36px;
    border: 1px solid #fed7aa;
    border-radius: 18px;
    background: linear-gradient(135deg, #fff7ed, #fff);
  }

  .eyebrow {
    color: #ea5b0c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 12px 0;
    color: #1e293b;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.2;
  }

  .welcome-description {
    max-width: 650px;
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .section-heading {
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 0 0 8px;
    color: #1e293b;
    font-size: 22px;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .module-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 230px;
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 24px rgb(15 23 42 / 4%);
  }

  .module-icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: 14px;
    background: #fff7ed;
    font-size: 25px;
  }

  .module-content {
    flex: 1;
  }

  .module-content h3 {
    margin: 0 0 10px;
    color: #1e293b;
    font-size: 19px;
  }

  .module-content p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  .module-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    color: #ea5b0c;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .module-link:hover {
    color: #c94c08;
  }

  .module-link:focus-visible {
    outline: 2px solid #ea5b0c;
    outline-offset: 4px;
  }

  .empty-modules {
    padding: 24px;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    color: #64748b;
  }

  .profile-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
  }

  .error-card {
    max-width: 560px;
    margin: 60px auto;
    padding: 32px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
  }

  .error-card p {
    color: #64748b;
    line-height: 1.6;
  }

  .retry-button {
    min-height: 46px;
    padding: 12px 20px;
    border: 0;
    border-radius: 8px;
    background: #ea5b0c;
    color: #fff;
    font-weight: 700;
    cursor: pointer;
  }

  .retry-button:hover {
    background: #c94c08;
  }

  .retry-button:focus-visible {
    outline: 2px solid #ea5b0c;
    outline-offset: 3px;
  }

  .stats-card {
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
  }

  .stats-message {
    margin: 0;
    padding: 20px 0;
    color: #64748b;
    font-size: 14px;
    text-align: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .stats-grid[hidden],
  .stats-message[hidden],
  .stats-error[hidden] {
    display: none;
  }

  .stat-item {
    display: flex;
    min-width: 0;
    min-height: 112px;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 20px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #f8fafc;
  }

  .stat-label {
    color: #64748b;
    font-size: 13px;
    line-height: 1.4;
  }

  .stat-value {
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
  }

  .stat-total {
    color: #ea5b0c;
  }

  .stat-pending {
    color: #b45309;
  }

  .stats-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
  }

  .stats-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ea5b0c;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .stats-link:hover {
    color: #c94c08;
  }

  .stats-link:focus-visible {
    outline: 2px solid #ea5b0c;
    outline-offset: 4px;
  }

  .stats-error {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .stats-error p {
    margin: 0;
    color: #b91c1c;
    font-size: 14px;
  }

  .retry-stats-button {
    min-height: 40px;
    padding: 10px 16px;
    border: 1px solid #fed7aa;
    border-radius: 8px;
    background: #fff7ed;
    color: #c2410c;
    font-weight: 700;
    cursor: pointer;
  }

  .retry-stats-button:hover {
    background: #ffedd5;
  }

  .retry-stats-button:focus-visible {
    outline: 2px solid #ea5b0c;
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 400px) {
    .stats-card {
      padding: 16px;
    }

    .stats-grid {
      gap: 10px;
    }

    .stat-item {
      min-height: 100px;
      padding: 14px;
    }

    .stat-value {
      font-size: 26px;
    }
  }

  @media (max-width: 600px) {
    .dashboard {
      width: min(100% - 32px, 1100px);
      padding: 28px 0 48px;
    }

    .dashboard-content {
      gap: 28px;
    }

    .welcome-section {
      padding: 24px;
    }

    .module-card,
    .profile-card {
      padding: 22px;
    }
  }
</style>
