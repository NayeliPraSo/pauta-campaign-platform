---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Registro"
  description="Crea tu cuenta para participar en nuestras campañas promocionales."
>
  <main class="auth-page">
    <p id="auth-loading" role="status" aria-live="polite">
      Verificando tu sesión...
    </p>

    <section
      id="auth-content"
      class="auth-card"
      aria-labelledby="register-title"
      hidden
    >
      <div class="auth-header">
        <span class="eyebrow">PAUTA CAMPAIGN PLATFORM</span>

        <h1 id="register-title">Crear una cuenta</h1>

        <p>
          Regístrate para participar en nuestras campañas y consultar tus
          resultados.
        </p>
      </div>

      <form id="register-form" novalidate>
        <div class="form-field">
          <label for="full_name">Nombre completo</label>

          <input
            type="text"
            id="full_name"
            name="full_name"
            autocomplete="name"
            maxlength="150"
            required
          />
        </div>

        <div class="form-field">
          <label for="email">Correo electrónico</label>

          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            maxlength="255"
            required
          />
        </div>

        <div class="form-field">
          <label for="password">Contraseña</label>

          <input
            type="password"
            id="password"
            name="password"
            autocomplete="new-password"
            minlength="12"
            required
            aria-describedby="password-help"
          />

          <small id="password-help">
            Debe contener al menos 12 caracteres.
          </small>
        </div>

        <div class="form-consents">
          <label class="checkbox-field">
            <input
              type="checkbox"
              name="accepted_terms"
              id="accepted_terms"
              required
            />

            <span> Acepto los términos y condiciones. </span>
          </label>

          <label class="checkbox-field">
            <input
              type="checkbox"
              name="accepted_privacy"
              id="accepted_privacy"
              required
            />

            <span> Acepto el aviso de privacidad. </span>
          </label>
        </div>

        <p
          id="form-message"
          class="form-message"
          role="status"
          aria-live="polite"
        >
        </p>

        <button type="submit" class="submit-button"> Crear cuenta </button>
      </form>

      <p class="auth-footer">
        ¿Ya tienes una cuenta?
        <a href="/login">Inicia sesión</a>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import { apiFetch, ApiError } from "../lib/api";

  import { redirectIfAuthenticated } from "../lib/redirectIfAuthenticated";

  import type {
    RegistroParticipante,
    RespuestaRegistro,
  } from "../lib/auth.types";

  // Elementos del formulario

  const form = document.querySelector<HTMLFormElement>("#register-form");

  const message = document.querySelector<HTMLElement>("#form-message");

  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  // Elementos para controlar la visibilidad
  // mientras se verifica la sesión.

  const authLoading = document.querySelector<HTMLElement>("#auth-loading");

  const authContent = document.querySelector<HTMLElement>("#auth-content");

  /**
   * Comprueba si el participante ya tiene
   * una sesión activa.
   *
   * Si está autenticado, lo redirige al dashboard.
   * Si no está autenticado, muestra el formulario.
   */
  async function inicializarRegistro(): Promise<void> {
    try {
      const redirected = await redirectIfAuthenticated();

      if (redirected) {
        return;
      }
    } catch {
      // Si no podemos comprobar la sesión,
      // dejamos disponible el formulario.
    }

    if (authLoading) {
      authLoading.hidden = true;
    }

    if (authContent) {
      authContent.hidden = false;
    }
  }

  void inicializarRegistro();

  /**
   * Procesa el registro del participante.
   */
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) {
      return;
    }

    const fullName = form.elements.namedItem(
      "full_name",
    ) as HTMLInputElement | null;

    const email = form.elements.namedItem("email") as HTMLInputElement | null;

    const password = form.elements.namedItem(
      "password",
    ) as HTMLInputElement | null;

    const acceptedTerms = form.elements.namedItem(
      "accepted_terms",
    ) as HTMLInputElement | null;

    const acceptedPrivacy = form.elements.namedItem(
      "accepted_privacy",
    ) as HTMLInputElement | null;

    if (
      !fullName ||
      !email ||
      !password ||
      !acceptedTerms ||
      !acceptedPrivacy ||
      !message ||
      !submitButton
    ) {
      return;
    }

    const data: RegistroParticipante = {
      full_name: fullName.value.trim(),
      email: email.value.trim().toLowerCase(),
      password: password.value,
      accepted_terms: acceptedTerms.checked,
      accepted_privacy: acceptedPrivacy.checked,
    };

    if (!data.full_name) {
      message.dataset.status = "error";
      message.textContent = "Debes proporcionar tu nombre completo.";
      return;
    }

    message.textContent = "";
    message.removeAttribute("data-status");

    submitButton.disabled = true;
    submitButton.textContent = "Creando cuenta...";

    try {
      const response = await apiFetch<RespuestaRegistro, RegistroParticipante>(
        "/api/auth/register",
        {
          method: "POST",
          body: data,
        },
      );

      message.dataset.status = "success";
      message.textContent =
        response.message ?? "Tu cuenta se registró correctamente.";

      form.reset();
    } catch (error) {
      message.dataset.status = "error";

      if (error instanceof ApiError) {
        message.textContent = error.message;
      } else {
        message.textContent =
          "No fue posible conectar con el servidor. Inténtalo nuevamente.";
      }
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Crear cuenta";
    }
  });
</script>

<style>
  .auth-page {
    display: grid;
    min-height: 100vh;
    padding: 32px 20px;
    place-items: center;
  }

  .auth-card {
    width: 100%;
    max-width: 480px;
    padding: clamp(24px, 5vw, 40px);
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 12px 40px rgb(15 23 42 / 5%);
  }

  .auth-card[hidden],
  #auth-loading[hidden] {
    display: none;
  }

  #auth-loading {
    color: #64748b;
    font-size: 14px;
    text-align: center;
  }

  .auth-header {
    margin-bottom: 32px;
  }

  .eyebrow {
    color: #ea5b0c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 16px 0 12px;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    line-height: 1.15;
  }

  .auth-header p,
  .auth-footer {
    color: #64748b;
    line-height: 1.6;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .form-field label {
    font-size: 14px;
    font-weight: 600;
  }

  .form-field input {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: #1f2937;
  }

  .form-field input:focus-visible {
    outline: 2px solid #ea5b0c;
    outline-offset: 2px;
  }

  .form-field small {
    color: #64748b;
    font-size: 12px;
  }

  .form-consents {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 24px 0;
  }

  .checkbox-field {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
    cursor: pointer;
  }

  .checkbox-field input {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    accent-color: #ea5b0c;
  }

  .form-message {
    min-height: 20px;
    margin: 20px 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
  }

  .form-message[data-status="success"] {
    color: #15803d;
  }

  .form-message[data-status="error"] {
    color: #b91c1c;
  }

  .submit-button {
    width: 100%;
    min-height: 46px;
    padding: 12px 16px;
    border: 0;
    border-radius: 8px;
    background: #ea5b0c;
    color: #fff;
    font-weight: 700;
    transition: background 0.2s ease;
  }

  .submit-button:hover {
    background: #c94c08;
  }

  .submit-button:focus-visible {
    outline: 2px solid #1f2937;
    outline-offset: 3px;
  }

  .submit-button:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  .auth-footer {
    margin: 24px 0 0;
    font-size: 14px;
    text-align: center;
  }

  .auth-footer a {
    color: #ea5b0c;
    font-weight: 700;
  }
</style>
